  basicstyle=\small\ttfamily\color{taInk},
  keywordstyle=\color{taSlate}\bfseries,
  commentstyle=\color{taSlateMute}\itshape,
  stringstyle=\color{taPhaseTwo},
  numberstyle=\tiny\color{taSlateMute},
  numbers=left,
  stepnumber=1,
  numbersep=10pt,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  breakautoindent=true,
  breakindent=1.8em,
  columns=fullflexible,
  keepspaces=true,
  frame=leftline,
  rulecolor=\color{taSlate},
  backgroundcolor=\color{taPaperDeep!40!taPaper},
  frameround=ffff,
  xleftmargin=1.4em,
  framexleftmargin=1.1em,
  framesep=6pt,
  framerule=2.4pt,
  aboveskip=9pt,
  belowskip=3pt
}

\lstdefinestyle{bookoutput}{
  language={},
  basicstyle=\small\ttfamily,
  keywordstyle=\color{taInk},
  commentstyle=\color{taInk},
  stringstyle=\color{taInk},
  numbers=none,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  breakautoindent=true,
  breakindent=1.4em,
  columns=fullflexible,
  keepspaces=true,
