}
\lstset{style=bookpython}

% 출력 블록은 listings 대신 fvextra를 사용합니다.
% listings는 CJK 멀티바이트 문자열을 글자 단위로 안정적으로 끊지 못해
% 공백 없는 긴 한글 생성문이 오른쪽 마진을 넘는 문제가 있습니다.
\DefineVerbatimEnvironment{bookoutputbox}{Verbatim}{
  breaklines=true,
  breakanywhere=true,
  breaksymbolleft={},
  breaksymbolright={},
  fontsize=\small,
  formatcom=\color{taInk},
  frame=leftline,
  framerule=2.4pt,
  framesep=6pt,
  rulecolor=\color{taSlateMute},
  fillcolor=\color{taPaper},
  xleftmargin=1.4em,
  tabsize=2
}

\tcbset{
  taboxbase/.style={
    enhanced, breakable,
    sharp corners,
    boxrule=0pt,
    left=12pt, right=12pt, top=10pt, bottom=10pt,
    fontupper=\color{taInk},
  }
}

% HF Hub .box — accent-soft (cream-yellow) 배경 + 좌측 hf 오렌지 굵은 룰.
% box-mark 는 사용자 인자 #1 — 모노 액센트 키커.
\newtcolorbox{noteBox}[1][]{
  enhanced,
  breakable,
  width=\linewidth,
  colback=taPhaseZero,
  colframe=taSlate,
  boxrule=0pt,
  leftrule=3pt,
  sharp corners,
  left=14pt,right=16pt,top=12pt,bottom=12pt,
  before upper={%
    \ifstrempty{#1}{}{\noindent{\sffamily\footnotesize\bfseries\color{taSlate}\MakeUppercase{#1}}\par\vspace{4pt}}%
  }
}

% HF Hub .box.faq — 투명 배경 + ink-2 굵은 좌측 룰 + 얇은 회색 외곽선.
\newtcolorbox{faqBox}[1]{
  enhanced,
  breakable,
  width=\linewidth,
  colback=taPaper,
  colframe=taPaperDeep,
  boxrule=0.6pt,
  leftrule=3pt,
  borderline west={3pt}{0pt}{taSubtext},
  sharp corners,
  left=14pt,right=16pt,top=12pt,bottom=12pt,
  before upper={%
    \noindent{\sffamily\footnotesize\bfseries\color{taSlate}FAQ}\quad
    {\sffamily\small\bfseries\color{taInk}\raggedright #1\par}
    \vspace{6pt}%
  },
  before skip=10pt,
  after skip=8pt
}

% HF Hub .box (▷ 미리보기) — accent-soft 배경 + 좌측 액센트 룰 + 모노 키커.
