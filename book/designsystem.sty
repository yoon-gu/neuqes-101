\newcounter{taphasecur}
\newif\ifregisterphasepart

% \hfphasebreak — Phase 본문 (\phasepart #2) 안에서 줄바꿈 위치를 표시.
% phase divider 페이지에선 \\ 로 두 줄, TOC 에선 공백 + \mbox 로 한 줄 유지.
% Robust 로 선언해 \addcontentsline 의 .toc 쓰기 단계에서 미리 펼쳐지지 않게.
\DeclareRobustCommand{\hfphasebreak}{\\}

% TOC 의 Phase 행을 렌더하는 매크로 — 디자인의 PageTOC 그룹 헤더.
% 시각: ink 박스 위 옐로 mono "Phase N" + sans bold 본문 + 모노 ink-3 secondary.
% hyperref PDF bookmark 용 평문은 \texorpdfstring 으로 분리.
\newcommand{\tocphase}[3]{%
  \texorpdfstring{%
    \begingroup
    %% TOC 에선 \hfphasebreak 을 공백으로 펼치고 \mbox 로 감싸 줄바꿈 차단.
    \renewcommand{\hfphasebreak}{ }%
    {\setlength{\fboxsep}{2.5pt}%
     \mbox{\colorbox{taInk}{\sffamily\bfseries\fontsize{7.5pt}{9pt}\selectfont
      \color{taSlateLight}\,Phase~#1\,}}}%
    \quad
    \mbox{\sffamily\bfseries\fontsize{11pt}{13pt}\selectfont\color{taInk}#2}%
    \quad
    {\sffamily\fontsize{8pt}{10pt}\selectfont\color{taSlateMute}#3}%
    \endgroup
  }{Phase #1: #2}%
}

\newcommand{\tocbookpart}[3]{%
  \texorpdfstring{%
    \begingroup
    {\setlength{\fboxsep}{2.5pt}%
     \mbox{\colorbox{taInk}{\sffamily\bfseries\fontsize{7.5pt}{9pt}\selectfont
      \color{taSlateLight}\,#1\,}}}%
    \quad
    \mbox{\sffamily\bfseries\fontsize{11pt}{13pt}\selectfont\color{taInk}#2}%
    \quad
    {\sffamily\fontsize{8pt}{10pt}\selectfont\color{taSlateMute}#3}%
    \endgroup
  }{#1: #2}%
}

\newcommand{\phasepart}[5]{%
  \registerphaseparttrue
  \phasedivider{#1}{#2}{#3}{#4}{#5}%
}

\newcommand{\appendixpart}[4]{%
  \cleardoublepage
  \refstepcounter{part}%
  \addcontentsline{toc}{part}{\protect\tocbookpart{APPENDIX}{#1}{#2}}%
  \markboth{Appendix. #1}{Appendix. #1}%
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[hfInk]
      (current page.north west) rectangle (current page.south east);
    \node[anchor=north west, text=hfPaper, opacity=0.55,
          font=\hfMono\fontsize{7.5pt}{9pt}\selectfont]
      at ([xshift=20mm, yshift=-18mm]current page.north west)
      {REFERENCE OPENER \ \textbf{·}\ \ Appendix};
    \node[anchor=north east, text=hfPaper, opacity=0.50,
          font=\hfMono\fontsize{7.5pt}{9pt}\selectfont]
      at ([xshift=-18mm, yshift=-18mm]current page.north east)
      {#3};
    \node[anchor=west, text=hfAccentSoft, opacity=0.85,
          font=\hfPen\fontsize{22pt}{22pt}\selectfont]
      at ([xshift=20mm, yshift=-65mm]current page.north west)
      {참고로,};
    \node[anchor=north west, text=hfPaper, text width=160mm,
          font=\hfDisplay\bfseries\fontsize{44pt}{52pt}\selectfont]
      at ([xshift=20mm, yshift=-78mm]current page.north west)
      {#1};
    \draw[hfAccent, line width=1.4pt]
      ([xshift=20mm, yshift=-128mm]current page.north west) -- ++(20mm, 0);
    \node[anchor=north west, text=hfPaper, opacity=0.85, text width=140mm,
          font=\hfDisplay\fontsize{12pt}{18pt}\selectfont]
      at ([xshift=20mm, yshift=-138mm]current page.north west)
      {#2\\[2pt]\textit{\textcolor{hfPaper!55!black}{#3}}};
    \draw[hfPaper, line width=0.4pt, opacity=0.30]
      ([xshift=20mm, yshift=-185mm]current page.north west) --
      ([xshift=-18mm, yshift=-185mm]current page.north east);
    \node[anchor=north west, text=hfPaper, opacity=0.55,
          font=\hfMono\fontsize{7.5pt}{9pt}\selectfont]
      at ([xshift=20mm, yshift=-192mm]current page.north west)
      {APPENDIX};
    \node[anchor=north west, text=hfPaper,
          font=\hfDisplay\bfseries\fontsize{52pt}{52pt}\selectfont]
      at ([xshift=20mm, yshift=-200mm]current page.north west)
      {REF};
    \node[anchor=north west, inner sep=0pt]
      at ([xshift=66mm, yshift=-198mm]current page.north west)
      {\begin{minipage}{90mm}\setlength{\parskip}{6pt}\raggedright #4\end{minipage}};
  \end{tikzpicture}
  \cleardoublepage
}

%% \chapline — 디자인의 phase-page 하단 chapter chip 그리드 한 칸. 디자인은
%% 4 컬럼 그리드지만 LaTeX에선 minipage stretch 로 flow + 끝에 자동 wrap.
%% paper 색 텍스트 (dark phase-page 배경 위) — kicker (mono 모노) + 디스플레이.
\newcommand{\chapline}[3]{%
  \begin{minipage}[t]{42mm}%
    \raggedright
    \color{hfPaper!85!black}%
    {\hfMono\fontsize{7.5pt}{9pt}\selectfont\color{hfPaper!55!black}#1}\par
    \vspace{1pt}
    {\hfDisplay\bfseries\fontsize{9.5pt}{11pt}\selectfont\color{hfPaper}#2}\par
    \vspace{0.5pt}
    {\hfMono\fontsize{7pt}{8.5pt}\selectfont\color{hfPaper!50!black}#3}\par
  \end{minipage}\hspace{2mm}\ignorespaces
}

%% phase-divider — 디자인의 PagePhase 매칭. dark ink 풀-페이지 배경 위에
%% pen-script kicker + 모뉴멘탈 serif 타이틀 + 디스플레이 설명 + 하단 phase
%% indicator + chapter chip strip (#5 의 \chapline 들).
\newcommand{\phasedivider}[5]{%
  \setcounter{taphasecur}{#1}%
  \cleardoublepage
  \ifregisterphasepart
    \refstepcounter{part}%
    %% TOC 엔트리: 디자인의 PageTOC 그룹 헤더 (Phase 칩 + 본문 + 모노 secondary).
    %% 실제 렌더링은 \tocphase 매크로가 담당하고, hyperref bookmark 용
    %% 평문은 texorpdfstring 두 번째 인자가 제공.
    \addcontentsline{toc}{part}{\protect\tocphase{#1}{#2}{#3}}%
    \markboth{Phase #1. #2}{Phase #1. #2}%
    \registerphasepartfalse
  \fi
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    %% full-page dark background (hfInk = #1F1F1F)
    \fill[hfInk]
      (current page.north west) rectangle (current page.south east);

    %% 상단 eyebrow 라인 — 좌: PART OPENER · phase note, 우: chapter range
    \node[anchor=north west, text=hfPaper, opacity=0.55,
          font=\hfMono\fontsize{7.5pt}{9pt}\selectfont]
      at ([xshift=20mm, yshift=-18mm]current page.north west)
      {PART OPENER \ \textbf{·}\ \ Phase #1};
    \node[anchor=north east, text=hfPaper, opacity=0.50,
          font=\hfMono\fontsize{7.5pt}{9pt}\selectfont]
      at ([xshift=-18mm, yshift=-18mm]current page.north east)
      {#4};

    %% Pen-script kicker (handwritten, accent-soft cream)
    \node[anchor=west, text=hfAccentSoft, opacity=0.85,
          font=\hfPen\fontsize{22pt}{22pt}\selectfont]
      at ([xshift=20mm, yshift=-65mm]current page.north west)
      {이제부터,};

    %% 모뉴멘탈 타이틀 — Nanum Gothic ExtraBold, paper color.
    %% 긴 한국어 제목이 어색한 위치에서 끊기지 않도록 폭은 넓게(160mm), 폰트는 약간 작게.
    \node[anchor=north west, text=hfPaper, text width=160mm,
          font=\hfDisplay\bfseries\fontsize{44pt}{52pt}\selectfont]
      at ([xshift=20mm, yshift=-78mm]current page.north west)
      {#2};

    %% 짧은 액센트 룰 (accent orange)
    \draw[hfAccent, line width=1.4pt]
      ([xshift=20mm, yshift=-128mm]current page.north west) -- ++(20mm, 0);

    %% 설명 라인 (한국어 부제 + 영어 secondary)
    \node[anchor=north west, text=hfPaper, opacity=0.85, text width=140mm,
          font=\hfDisplay\fontsize{12pt}{18pt}\selectfont]
      at ([xshift=20mm, yshift=-138mm]current page.north west)
      {#3\\[2pt]\textit{\textcolor{hfPaper!55!black}{#4}}};

    %% 하단 영역 ─ horizontal rule + PHASE label + 큰 phase number + dots
    \draw[hfPaper, line width=0.4pt, opacity=0.30]
      ([xshift=20mm, yshift=-185mm]current page.north west) --
      ([xshift=-18mm, yshift=-185mm]current page.north east);

