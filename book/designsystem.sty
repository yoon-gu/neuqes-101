% designsystem.sty
% Theme-neutral book UI commands. Load a theme before this package.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{designsystem}[2026/05/04 v0.1 Text Analysis book design system]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{adjustbox}
\RequirePackage{caption}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{fvextra}
\RequirePackage{etoolbox}
\tcbuselibrary{listings, skins}
\usetikzlibrary{calc, positioning}

\colorlet{BookInk}{taInk}
\colorlet{BookMuted}{taSubtext}
\colorlet{BookBlue}{taSlate}
\colorlet{BookCyan}{taSlateLight}
\colorlet{BookGreen}{taPhaseOne}
\colorlet{BookOrange}{taPhaseTwo}
\colorlet{BookRed}{taPhaseThree}
\colorlet{BookPaper}{taPaper}
\colorlet{CodeBg}{taPaper}
\colorlet{CodeRule}{taPaperDeep}

% 디자인 시안의 본문은 링크가 ink 색이고 액센트는 강조 부분에만 사용.
% TOC/cross-ref가 HF 오렌지로 도배되지 않도록 linkcolor 는 ink 로 묶고,
% 외부 URL 만 액센트(orange).
\hypersetup{
  colorlinks=true,
  linkcolor=taInk,
  urlcolor=taSlate,
  citecolor=taSubtext,
  pdftitle={Hugging Face로 시작하는 텍스트 분석 입문},
  pdfauthor={황윤구, 유창민}
}

\renewcommand{\figurename}{그림}
\renewcommand{\tablename}{표}
\renewcommand{\listfigurename}{그림 목록}
\renewcommand{\listtablename}{표 목록}

% 디자인의 .fig-cap / .tbl-cap 패턴:
% 라벨 ("그림 N.M", "표 N.M") = 모노 액센트 작은 글씨, 본문 = 작은 ink-2.
\DeclareCaptionFont{taLabelFont}{\sffamily\footnotesize\bfseries\color{taSlate}}
\DeclareCaptionFont{taBodyFont}{\rmfamily\footnotesize\color{taSubtext}}
\captionsetup{
  labelsep=quad,
  labelfont={taLabelFont},
  textfont={taBodyFont},
  skip=6pt
}
\captionsetup[table]{
  justification=centering,
  singlelinecheck=true,
  position=above,
  skip=6pt
}
\captionsetup[figure]{
  justification=raggedright,
  singlelinecheck=false,
  position=below,
  skip=6pt
}

\newenvironment{booktable}[2]{%
  \par\begin{center}
  \captionsetup{type=table}%
  \small
  \def\booktablecaption{#1}%
  \def\booktablelabel{#2}%
}{%
  \vspace{4pt}%
  \captionof{table}{\booktablecaption}\label{\booktablelabel}%
  \end{center}\par
}

% 코드 블록 — HF Hub 디자인의 .code 패턴: 좌측에 굵은 액센트 바 + warm-cream 살짝 톤다운된 배경.
% 라인 넘버 영역은 디자인의 .ln 칸을 흉내 — taSlateMute (ink-3) 우측 정렬.
\lstdefinestyle{bookpython}{
